{
  "name": "touchline-football",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 server.py",
    "start": "python3 server.py",
    "test": "node --test tests/*.test.js && python3 -m unittest discover -s tests -p 'test_*.py'",
    "analyze": "python3 analysis_agent.py",
    "test:contract": "python3 -m unittest discover -s tests -p test_contract.py",
    "validate:schema": "node scripts/validate_contracts.mjs --dataset data data/league",
    "test:decision-analysis": "python3 -m unittest discover -s tests -p 'test_decision_integration.py'",
    "validate:decision-analysis": "node scripts/validate_decision_analysis.mjs",
    "validate:decision-dataset": "node scripts/validate_decision_dataset.mjs",
    "audit:decisions": "python3 scripts/audit_decision_consistency.py --output docs/reports/decision-consistency.json",
    "test:unification": "node --test tests/decision-unification.test.js && python3 -m unittest discover -s tests -p test_decision_unification.py"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1"
  }
}
