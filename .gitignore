__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/
dist/
build/
# Repository-root downloads only. The trimmed Touchline sample under touchline/data is tracked.
/data/

# Touchline bulk outputs. Regenerate with touchline/generate.py.
# Every match's events, states, preview and decision records are tracked, so a
# clean checkout runs the dashboard, the coach page and decision analysis with no
# generation step. Full tracking stays ignored: the only tracked tracking.jsonl
# is the SynthData 25 Hz clip (see touchline/data/samples/README.md), which is
# what the pitch sample reads.
touchline/data/league-alt/
# Default output of touchline/scripts/synth/generate.py (a full 100 min at 25 Hz is large).
touchline/scripts/synth/data/
touchline/data/**/tracking.jsonl
!touchline/data/samples/sample_25hz_10min/tracking.jsonl
node_modules/
web/public/preview.mp4

# Local scratch: regenerated video-demo outputs.
demo_output/

# Local secrets and tool caches. Never commit an environment file.
.env
.env.*
!.env.example
coverage/
.vite/

# Local deployment packages
.deploy/

# Private video observations, media, inference jobs and optional weights
touchline/.local/
/video-validation-output/
